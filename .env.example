# Copy to .env in the repository root. Development only.
DEBUG=True
DJANGO_SECRET_KEY=dev-replace-with-a-random-secret-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=pixelguessr
POSTGRES_USER=pixelguessr
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://pixelguessr:local-development-only@localhost:5432/pixelguessr
REDIS_URL=redis://localhost:6379/0
# Explicit lightweight development fallback; never enable in production.
USE_SQLITE=False
LOCAL_SERVICES=False
# Optional private S3-compatible object storage. Keep bucket public access blocked.
USE_S3=False
S3_BUCKET_NAME=
S3_REGION_NAME=us-east-1
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# Prefer IAM workload credentials. Set these only if necessary, never commit .env.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
